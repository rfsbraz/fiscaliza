# Cloudflare Pages headers. deploy/pages.py copies this into the build output.
# Pages joins a header from every rule that matches with a comma, so Cache-Control is set per
# path below and never on /*.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://app.parlamento.pt https://www.parlamento.pt; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Vite puts a content hash in every file name under assets/.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# The data changes on each deploy and its file names don't.
/api/*
  Cache-Control: public, max-age=300

    {
      "path": "estatisticas.contexto_oposicao",
      "reason": "F09: government hard-coded as PS and invented opposition approval rates. Dropped (D2)."
    },
    {
      "path": "estatisticas.percentil_nacional",
      "reason": "Ranked raw initiative counts, which follow each group's signing practice, against everyone with any seat. Dropped; comparisons stay within the group (estatisticas.comparacao)."
    },
    {
      "path": "estatisticas.iniciativas_propostas",
      "reason": "Career headline total of every initiative the deputy is listed on, mostly whole-group lists. Replaced by the per-legislature signing split (estatisticas.iniciativas_legislaturas[].assinatura)."
    },
    {
      "path": "estatisticas.iniciativas_aprovadas",
      "reason": "Pooled over the career and all types. Replaced by per-legislature, per-type counts (estatisticas.iniciativas_legislaturas[].aprovacao)."
    },
    {
      "path": "estatisticas.taxa_aprovacao",
      "reason": "Approved over everything proposed, so lapsed and pending initiatives counted as failures. Replaced by a rate over decided initiatives per legislature and type."
    },
    {
      "path": "estatisticas.media_partido_iniciativas",
      "reason": "Raw counts against everyone with any seat. Replaced by per-seat-year figures within the group (estatisticas.comparacao)."
    },
    {
      "path": "estatisticas.media_partido_intervencoes",
